PORT=4000

# --- Alertas ---------------------------------------------------------------
# Postgres (Neon, Supabase, Vercel Postgres ou local). As tabelas são criadas
# automaticamente na primeira requisição.
DATABASE_URL=

# Segredo exigido pela rota /api/cron/check-alerts (header
# "Authorization: Bearer <CRON_SECRET>"). Use um valor longo e aleatório.
CRON_SECRET=

# Só para rodar localmente / em servidor próprio: verifica os alertas ativos
# no próprio processo a cada N minutos. Deixe vazio no Vercel.
ALERTS_INTERVAL_MINUTES=

# E-mail via Resend (https://resend.com). Vários destinatários: separe por vírgula.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Watch Tracker <onboarding@resend.dev>
ALERT_EMAIL_TO=

# Telegram: crie um bot com o @BotFather e pegue o chat id (ver README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot interativo (/buscar no Telegram, ver TELEGRAM_BOT.md). Segredo que o
# Telegram envia em cada chamada do webhook — valor longo e aleatório, igual
# aqui e no Vercel. Sem ele, o bot só envia avisos e não responde comandos.
TELEGRAM_WEBHOOK_SECRET=

# URL pública do app (botão "Abrir o app" no bot). No Vercel é opcional: usa a
# URL de produção automaticamente.
APP_URL=
